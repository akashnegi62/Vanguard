PORT=5001
NODE_ENV=development

# -------------------------------------------------------------
# Supabase PostgreSQL Database URLs
# -------------------------------------------------------------
# 1. DATABASE_URL: Transaction Pooler connection string (Port 6543)
# e.g.: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mens_fashion_store?schema=public"

# 2. DIRECT_URL: Direct database connection string (Port 5432) for migrations & Prisma CLI
# e.g.: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/mens_fashion_store?schema=public"

# -------------------------------------------------------------
# Supabase API Credentials (Optional: For Supabase Storage / Auth)
# -------------------------------------------------------------
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT & Application Config
JWT_SECRET=super_secret_jwt_key_mens_fashion_2026_demo
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
